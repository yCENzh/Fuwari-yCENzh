---
import type { PostWithMetadata } from "@utils/content-utils";
import PostCard from "./PostCard.astro";

// 从props中获取page对象
const { page } = Astro.props;

// 动画配置
const ANIMATION_DELAY_START = 0; // 初始延迟
const ANIMATION_DELAY_INTERVAL = 50; // 每张卡片之间的延迟间隔
---
<!-- 文章列表容器 -->
<div 
  class="transition flex flex-col rounded-(--radius-large) 
         bg-(--card-bg) py-1 md:py-0 md:bg-transparent 
         md:gap-4 mb-4"
>
  {
    // 遍历文章数据
    page.data.map((entry: PostWithMetadata, index: number) => {
      // 计算当前卡片的动画延迟时间
      const delay = ANIMATION_DELAY_START + index * ANIMATION_DELAY_INTERVAL;
      
      return (
        // 渲染文章卡片组件
        <PostCard
          entry={entry}
          metadata={entry.metadata}
          class:list="onload-animation"
          style={`animation-delay: calc(var(--content-delay) + ${delay}ms); content-visibility: auto; contain-intrinsic-size: auto 300px;`}
        />
      );
    })
  }
</div>
